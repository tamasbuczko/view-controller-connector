{
  "name": "@vcc/ui",
  "version": "0.1.0",
  "description": "VCC reference UI shells",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": ["dist", "src/theme.css"],
  "scripts": {
    "build": "tsup && node ./scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@vcc/core": "workspace:*"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vcc/core": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
