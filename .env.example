# Másold .env-be. A .env SOHA ne kerüljön gitbe.
# Értékek csak helyben / CI secret store-ban.

VCC_SIGNALING_HOST=127.0.0.1
VCC_SIGNALING_PORT=8787
# development | production — production requires VCC_ALLOWED_ORIGINS
VCC_ENV=development
# Produkcióban kötelező (ne commitold az értéket):
# VCC_ALLOWED_ORIGINS=https://your-host.example
# VCC_SESSION_SECRET=
# Demo session picker (default: on for local-bound non-production only):
# VCC_ALLOW_SESSION_LIST=1
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
# LAN phone HTTPS (scripts/lan-https-gateway.mjs):
# VCC_LAN_IP=192.168.1.118
# VCC_HTTPS_PORT=8443
