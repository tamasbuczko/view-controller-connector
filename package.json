{
  "name": "view-controller-connector",
  "private": true,
  "version": "0.1.0",
  "description": "View–Controller Connector (VCC) — embeddable Observer/View/Controller realtime module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:signaling": "pnpm --filter @vcc/signaling dev",
    "dev:demo": "pnpm --filter @vcc/demo-php start",
    "certs:lan": "node ./scripts/gen-lan-certs.mjs",
    "dev:https-proxy": "node ./scripts/https-demo-proxy.mjs",
    "dev:lan-gateway": "node ./scripts/lan-https-gateway.mjs",
    "dev:lan-signaling": "node ./scripts/start-lan-signaling-local.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @vcc/core test && pnpm --filter @vcc/signaling test && pnpm --filter @vcc/signaling test:s3",
    "test:s3": "pnpm --filter @vcc/signaling test:s3",
    "clean": "pnpm -r exec rimraf dist"
  },
  "devDependencies": {
    "http-proxy": "^1.18.1",
    "selfsigned": "^2.4.1"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
